{
  "name": "@taxalia/chatbot-backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "postinstall": "npm run build",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "typecheck": "tsc --noEmit",
    "blog:export": "tsx scripts/export-posts.ts",
    "blog:import": "tsx scripts/import-posts.ts",
    "blog:import:dry": "tsx scripts/import-posts.ts data/posts-export.json --dry-run",
    "blog:migrate:sqlite": "tsx scripts/migrate-sqlite-blog.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.14",
    "hono": "^4.12.23",
    "marked": "^18.0.5",
    "mysql2": "^3.14.4",
    "nodemailer": "^9.0.1",
    "ollama": "0.6.3",
    "pino": "9.5.0",
    "sanitize-html": "^2.17.4",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "@types/nodemailer": "^8.0.0",
    "@types/sanitize-html": "^2.16.1",
    "better-sqlite3": "^12.11.1",
    "tsx": "^4.22.4",
    "typescript": "5.6.3",
    "vitest": "4.1.8"
  }
}
